# WORKSPACE environment configuration
# Copy to .env.local and fill in your Supabase project values.
# Supabase Dashboard -> Project Settings -> API

# --- Supabase (required for real auth + database) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose this with a NEXT_PUBLIC_ prefix.
# Used by /api/invite to send real invitation emails.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tests only (npm test). Supabase management API token with the "Projects"
# scope — the acceptance suite uses it to TRUNCATE tables in phase 0.
# Create at: Supabase Dashboard -> Account -> Access Tokens
SUPABASE_PAT=your-management-api-token

# --- Optional: local preview without Supabase ---
# Loads in-memory demo data. No login required. Data is not persisted.
# NEVER enable this in production.
# NEXT_PUBLIC_DEMO_MODE=true
